---
import Base from '../../layouts/Base.astro';
import VorschauHinweis from '../../components/VorschauHinweis.astro';
import { pfad } from '../../utils/url.js';
import daten from '../../data/mitglieder.json';

const { mitglieder, begegnungen2026 } = daten;

const aktiv  = mitglieder.filter((m) => m.status === 'aktiv').length;
const ruhend = mitglieder.filter((m) => m.status === 'ruhend').length;
const ohneTurnier = mitglieder.filter((m) => m.turniere2026 === 0).length;

const rollenName = { spielfuehrer: 'Spielführer', vorstand: 'Vorstand', mitglied: 'Mitglied' };

// Begegnungen je Mitglied zählen — Grundlage der späteren Paarungsprüfung
const begegnungenVon = (id) =>
  begegnungen2026.filter((b) => b.a === id || b.b === id).length;
---

<Base titel="Mitgliederverwaltung (Vorschau)">
  <VorschauHinweis phase="2" was="So soll die Mitgliederverwaltung aussehen." />

  <section class="section">
    <div class="wrap">
      <h1>Mitgliederverwaltung</h1>
      <p class="einleitung">
        Der Stamm aller Mitglieder mit Vorgabe, Kontaktdaten und
        Teilnahmen. Grundlage für Einladungen, Auslosungen und
        Benachrichtigungen.
      </p>

      <ul class="kennzahlen">
        <li><span class="kennzahlen__wert">{mitglieder.length}</span><span class="kennzahlen__label">Mitglieder gesamt</span></li>
        <li><span class="kennzahlen__wert">{aktiv}</span><span class="kennzahlen__label">aktiv</span></li>
        <li><span class="kennzahlen__wert">{ruhend}</span><span class="kennzahlen__label">ruhend</span></li>
        <li><span class="kennzahlen__wert">{ohneTurnier}</span><span class="kennzahlen__label">2026 noch nicht gespielt</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--grey">
    <div class="wrap">
      <h2 class="section-title">
        <span aria-hidden="true">&#128101;</span> Alle Mitglieder
      </h2>

      <div class="werkzeuge">
        <div class="feld feld--suche">
          <label for="suche">Suchen</label>
          <input type="text" id="suche" value="" placeholder="Name oder E-Mail" readonly />
        </div>
        <div class="feld">
          <label for="f-status">Status</label>
          <select id="f-status" disabled>
            <option>Alle</option><option>Nur aktive</option><option>Nur ruhende</option>
          </select>
        </div>
        <div class="feld">
          <label for="f-hcp">Vorgabe</label>
          <select id="f-hcp" disabled>
            <option>Alle</option><option>bis 18</option><option>18 bis 26</option><option>über 26</option>
          </select>
        </div>
      </div>

      <div class="table-scroll" role="region" tabindex="0" aria-label="Mitgliederliste, seitlich scrollbar">
        <table class="mitglieder">
          <caption>Stand {daten.stand.split('-').reverse().join('.')}</caption>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Vorgabe</th>
              <th scope="col">E-Mail</th>
              <th scope="col">Mitglied seit</th>
              <th scope="col">Turniere 2026</th>
              <th scope="col">Begegnungen</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {mitglieder.map((m) => (
              <tr>
                <td>
                  <strong>{m.name}</strong>
                  {m.rolle !== 'mitglied' && (
                    <span class="rolle">{rollenName[m.rolle]}</span>
                  )}
                </td>
                <td class="zahl">{m.hcp}</td>
                <td class="mail">{m.email}</td>
                <td class="zahl">{m.eintritt}</td>
                <td class="zahl">{m.turniere2026}</td>
                <td class="zahl">{begegnungenVon(m.id)}</td>
                <td>
                  {m.status === 'aktiv' ? (
                    <span class="badge badge--done">
                      <span aria-hidden="true">&#10003;</span> Aktiv
                    </span>
                  ) : (
                    <span class="badge badge--open">
                      <span aria-hidden="true">&#9679;</span> Ruhend
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="tabellen-hinweis">
        Die Spalte <strong>Begegnungen</strong> zählt, mit wie vielen
        verschiedenen Mitgliedern jemand 2026 bereits in einem Flight oder
        einer Matchplay-Partie zusammengekommen ist. Daraus speist sich die
        Prüfung, ob eine Paarung sich wiederholt.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap schmal">
      <h2 class="section-title">
        <span aria-hidden="true">&#128100;</span> Ein Mitglied im Detail
      </h2>

      <div class="detail">
        <div class="detail__kopf">
          <span class="detail__bild" aria-hidden="true">AB</span>
          <div>
            <h3>A. Berger</h3>
            <p>Mitglied seit 2014 &middot; Vorgabe 18,2</p>
          </div>
        </div>

        <div class="detail__gitter">
          <div class="feld">
            <label for="d-name">Name</label>
            <input type="text" id="d-name" value="Andreas Berger" readonly />
          </div>
          <div class="feld">
            <label for="d-hcp">Aktuelle Vorgabe</label>
            <input type="text" id="d-hcp" value="18,2" readonly />
            <p class="hilfe">
              Wird beim Eintragen eines Turnierergebnisses fortgeschrieben.
              Der Verlauf bleibt erhalten.
            </p>
          </div>
          <div class="feld">
            <label for="d-mail">E-Mail-Adresse</label>
            <input type="email" id="d-mail" value="a.berger@beispiel.de" readonly />
          </div>
          <div class="feld">
            <label for="d-tel">Telefon</label>
            <input type="text" id="d-tel" value="0170 1234567" readonly />
          </div>
          <div class="feld">
            <label for="d-eintritt">Eintrittsdatum</label>
            <input type="text" id="d-eintritt" value="01.04.2014" readonly />
          </div>
          <div class="feld">
            <label for="d-rolle">Rolle</label>
            <select id="d-rolle" disabled>
              <option>Mitglied</option><option>Spielführer</option>
              <option>Vorstand</option><option>Administrator</option>
            </select>
          </div>
        </div>

        <h4 class="detail__zwischen">Einwilligungen</h4>
        <ul class="einwilligungen">
          <li><span aria-hidden="true">&#10003;</span> Rundmails des Vereins &mdash; erteilt am 12.03.2024</li>
          <li><span aria-hidden="true">&#10003;</span> Name in Ergebnislisten &mdash; erteilt am 12.03.2024</li>
          <li><span aria-hidden="true">&#10003;</span> Fotos veröffentlichen &mdash; erteilt am 12.03.2024</li>
          <li class="widerrufen"><span aria-hidden="true">&#10007;</span> Benachrichtigung aufs Handy &mdash; widerrufen am 04.08.2026</li>
        </ul>

        <div class="detail__knoepfe">
          <button class="btn btn--primary" type="button" aria-disabled="true">Speichern</button>
          <button class="btn btn--ghost" type="button" aria-disabled="true">Vorgabenverlauf</button>
          <button class="btn btn--ghost" type="button" aria-disabled="true">Daten exportieren</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="wrap schmal">
      <div class="note">
        <span class="note__icon" aria-hidden="true">&#128274;</span>
        <div>
          <h4>Diese Daten gehören nicht ins Repository</h4>
          <p>
            Adressen, Geburtsdaten und E-Mail-Adressen liegen in der
            Datenbank hinter der Anmeldung, nicht in einer Datei auf GitHub.
            Die Namen auf dieser Seite sind erfunden.
          </p>
          <p>
            Wer welche Kontaktdaten sehen darf, regeln die Zugriffsregeln in
            der Datenbank &mdash; nicht die Oberfläche. Ein Mitglied kommt
            auch dann nicht an fremde Adressen, wenn es die Schnittstelle
            direkt anspricht.
          </p>
        </div>
      </div>

      <p style="margin-top:32px">
        <a class="btn btn--ghost" href={pfad('/vorschau/verwaltung-turnier/')}>
          Weiter: Turnier zusammenstellen
        </a>
        <a class="btn btn--ghost" href={pfad('/vorschau/')}>Zur Übersicht</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .schmal { max-width: 820px; }
  .einleitung { font-size: var(--fs-lg); color: var(--text2); margin-top: 16px; max-width: 70ch; }

  .kennzahlen {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
    gap: 16px; margin-top: 32px;
  }
  .kennzahlen li {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow);
  }
  .kennzahlen__wert {
    display: block; font-size: 2.2rem; font-weight: 700;
    color: var(--gold-text); line-height: 1.1;
  }
  .kennzahlen__label { font-size: var(--fs-sm); color: var(--text3); }

  .werkzeuge {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (max-width: 720px) { .werkzeuge { grid-template-columns: 1fr; } }
  .werkzeuge .feld { margin-bottom: 0; }

  .mitglieder { min-width: 800px; }
  .mitglieder .zahl { font-variant-numeric: tabular-nums; }
  .mitglieder .mail { font-size: var(--fs-xs); color: var(--text2); }
  .rolle {
    display: inline-block; margin-left: 8px;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--gold-text);
  }
  .tabellen-hinweis {
    margin-top: 18px; font-size: var(--fs-sm); color: var(--text3);
    max-width: 70ch;
  }

  .detail {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow);
  }
  .detail__kopf {
    display: flex; align-items: center; gap: 20px;
    padding-bottom: 24px; margin-bottom: 26px;
    border-bottom: 1px solid var(--border);
  }
  .detail__bild {
    width: 64px; height: 64px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--blue); color: #fff;
    border-radius: 50%; font-weight: 700; font-size: 1.3rem;
  }
  .detail__kopf p { color: var(--text3); font-size: var(--fs-sm); margin-top: 4px; }

  .detail__gitter { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }
  @media (max-width: 620px) { .detail__gitter { grid-template-columns: 1fr; } }

  .detail__zwischen { margin: 14px 0 14px; }

  .einwilligungen { list-style: none; display: grid; gap: 8px; }
  .einwilligungen li {
    display: flex; gap: 12px; align-items: baseline;
    font-size: var(--fs-sm);
    padding: 10px 14px;
    background: var(--bg2);
    border-radius: 8px;
  }
  .einwilligungen span { color: #2a5c2e; font-weight: 700; }
  .widerrufen { color: var(--text3); }
  .widerrufen span { color: #8a3a2e; }

  .detail__knoepfe {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-top: 28px; padding-top: 24px;
    border-top: 1px solid var(--border);
  }
</style>
