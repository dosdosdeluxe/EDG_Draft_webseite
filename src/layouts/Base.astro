---
// Die Schrift wird mit ausgeliefert und NICHT von Google geladen.
// Das vermeidet die Übertragung von IP-Adressen an Google beim
// Seitenaufruf (LG München I, 3 O 17493/20) und macht die Seite schneller.
import '@fontsource-variable/inter';
import '../styles/design-system.css';
import { pfad } from '../utils/url.js';
import TopNav from '../components/TopNav.astro';
import TabBar from '../components/TabBar.astro';
import Footer from '../components/Footer.astro';

const {
  titel,
  beschreibung = 'Eagle Golfers Dribbdebach e.V. — Golfclub in Frankfurt am Main. Eagle Tour, Matchplay, Clubmeisterschaft und Termine.',
} = Astro.props;

const seitentitel = titel
  ? `${titel} — Eagle Golfers Dribbdebach e.V.`
  : 'Eagle Golfers Dribbdebach e.V.';

// Absolute Adressen. Beim Teilen in WhatsApp oder Facebook wird das
// Vorschaubild von dort geladen — ein relativer Pfad funktioniert nicht.
const seitenadresse = new URL(Astro.url.pathname, Astro.site).href;
const vorschaubild = new URL(pfad('/og-bild.jpg'), Astro.site).href;

// Die Entwurfsfassung soll nicht in der Google-Suche landen und der
// echten Vereinsseite Konkurrenz machen.
const keinIndex = process.env.NOINDEX === '1';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />

    <link rel="canonical" href={seitenadresse} />
    {keinIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={pfad("/logo.png")} type="image/png" />
    <link rel="apple-touch-icon" href={pfad("/icon-180.png")} />
    <link rel="manifest" href={pfad("/manifest.webmanifest")} />
    <meta name="theme-color" content="#122848" />

    <!-- Vorschau beim Teilen in WhatsApp, Facebook, LinkedIn -->
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Eagle Golfers Dribbdebach e.V." />
    <meta property="og:url" content={seitenadresse} />
    <meta property="og:image" content={vorschaubild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Wappen des Eagle Golfers Dribbdebach e.V. mit dem Schriftzug Golf mit Leidenschaft, ohne Standesdünkel"
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>

    <TopNav />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <TabBar />
  </body>
</html>

<style is:global>
  /* Abstand unten, damit die feste Tab-Leiste nichts verdeckt */
  @media (max-width: 899px) {
    body { padding-bottom: 0; }
  }
  main:focus { outline: none; }
</style>
